name: Rotate 90°, Boost Volume (200%) & Upload to B2

on:
  workflow_dispatch:
    inputs:
      video_url:
        description: 'Direct Video URL'
        required: true
        default: 'https://archive.org/download/BigBuckBunny_328/BigBuckBunny_512kb.mp4'
      file_name:
        description: 'Output File Name (e.g. myvideo.mp4)'
        required: true
        default: 'rotated_loud_video.mp4'
      folder_name:
        description: 'B2 Folder Name (without spaces)'
        required: true
        default: 'movie1'

jobs:
  process-and-upload:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Install System Tools (FFmpeg, yt-dlp & Rclone)
        run: |
          echo ">> Installing FFmpeg and Rclone..."
          sudo env DEBIAN_FRONTEND=noninteractive apt-get update -yqq
          sudo env DEBIAN_FRONTEND=noninteractive apt-get install -yqq ffmpeg rclone

          echo ">> Installing yt-dlp..."
          sudo wget -qO /usr/local/bin/yt-dlp https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp
          sudo chmod a+rx /usr/local/bin/yt-dlp

      - name: Download Video File
        run: |
          echo ">> Downloading video via yt-dlp..."
          yt-dlp --user-agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36" \
            -f "best[ext=mp4]/best" \
            -o "input.mp4" "${{ github.event.inputs.video_url }}"
          
          echo ">> Checking downloaded file size..."
          ls -lh input.mp4

      - name: Hard Rotate (90°) & Boost Volume to 200%
        run: |
          echo ">> Rotating 90 degrees and boosting audio volume to 200%..."
          
          # -vf "transpose=1" : वीडियो को 90 डिग्री घुमाने के लिए
          # -c:v libx264 -preset fast -crf 18 : बेहतरीन वीडियो क्वालिटी के लिए
          # -af "volume=2.0" : आवाज़ को 200% (दोगुना) करने के लिए
          # -c:a aac -b:a 128k : ऑडियो को वापस अच्छे फॉर्मेट में सेव करने के लिए
          ffmpeg -y -i input.mp4 \
            -vf "transpose=1" \
            -c:v libx264 -preset fast -crf 18 \
            -af "volume=3.0" \
            -c:a aac -b:a 128k \
            output.mp4
          
          echo ">> Processing completed. Output file size:"
          ls -lh output.mp4

      - name: Upload Single File to Backblaze via Rclone
        env:
          RCLONE_CONFIG_B2REMOTE_TYPE: b2
          RCLONE_CONFIG_B2REMOTE_ACCOUNT: ${{ vars.B2_KEY_ID }}
          RCLONE_CONFIG_B2REMOTE_KEY: ${{ vars.B2_APP_KEY }}
          BUCKET_NAME: ${{ vars.B2_BUCKET_NAME }}
          FOLDER: ${{ github.event.inputs.folder_name }}
          FILENAME: ${{ github.event.inputs.file_name }}
        run: |
          # Check for missing variables
          if [ -z "$RCLONE_CONFIG_B2REMOTE_ACCOUNT" ] || [ -z "$RCLONE_CONFIG_B2REMOTE_KEY" ] || [ -z "$BUCKET_NAME" ]; then
            echo "============================================================"
            echo "CRITICAL ERROR: MISSING GITHUB VARIABLES!"
            echo "Please ensure B2_KEY_ID, B2_APP_KEY, and B2_BUCKET_NAME are set in your repository's Variables."
            echo "============================================================"
            exit 1
          fi

          echo ">> Uploading single file with Rclone..."
          rclone copyto output.mp4 "b2remote:${BUCKET_NAME}/${FOLDER}/${FILENAME}" \
            --header-upload "Cache-Control: public, max-age=2592000" \
            --stats=5s \
            -v

      - name: Generate Public Link
        env:
          WORKER_URL: ${{ vars.CF_WORKER_URL }}
          FOLDER: ${{ github.event.inputs.folder_name }}
          FILENAME: ${{ github.event.inputs.file_name }}
        run: |
          WORKER_BASE="${WORKER_URL%/}"
          if [ -z "$WORKER_BASE" ]; then
            WORKER_BASE="https://YOUR_WORKER_NAME.workers.dev"
          fi

          PUBLIC_URL="${WORKER_BASE}/${FOLDER}/${FILENAME}"

          echo ""
          echo "============================================================"
          echo "SUCCESS! VIDEO ROTATED, VOLUME BOOSTED & UPLOADED."
          echo "YOUR FILE LINK:"
          echo "$PUBLIC_URL"
          echo "============================================================"
          echo ""
